import pandas as pd

# Sample Data
df = pd.DataFrame({
    "order_id": [1, 2, 2, 3, 4, 4],
    "customer_id": [101, 102, 102, 103, 104, 104],
    "amount": [500, 700, 700, 400, 900, 900]
})

print("\nOriginal Data:")
print(df)

# 1. Identify all duplicate rows
duplicates = df[df.duplicated()]
print("\nDuplicate Rows:")
print(duplicates)

# 2. Remove duplicate rows (keep first occurrence)
df_no_duplicates = df.drop_duplicates()
print("\nAfter Removing Duplicates:")
print(df_no_duplicates)

# 3. Keep only the last occurrence of duplicates
df_keep_last = df.drop_duplicates(keep="last")
print("\nKeeping Last Occurrence:")
print(df_keep_last)

# 4. Verify duplicates are removed
print("\nAny duplicates left?:", df_no_duplicates.duplicated().any())

# 5. Find duplicates using a subset of columns
subset_duplicates = df[df.duplicated(subset=["customer_id", "amount"])]
print("\nSubset-Based Duplicates (customer_id, amount):")
print(subset_duplicates)
